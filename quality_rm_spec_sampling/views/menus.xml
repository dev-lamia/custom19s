<odoo>
  <!-- Existing IDs remain stable so existing actions and data are preserved on upgrade. -->
  <menuitem id="menu_rm_qc_root" name="RM Quality" sequence="70" groups="base.group_user" active="False"/>

  <!-- Legacy daily-work menus remain for XML ID/upgrade compatibility only.
       Native Control Points and Quality Checks menus now open our forms. -->
  <menuitem id="menu_rm_qc_spec" name="RM QC Specification" parent="menu_rm_qc_root"
            sequence="10" active="False" action="action_rm_qc_spec"/>
  <menuitem id="menu_rm_qc_quality_checks" name="Quality Inspection" parent="menu_rm_qc_root"
            sequence="20" active="False" action="action_rm_qc_detailed_check"/>

  <!-- Set-up lists -->
  <menuitem id="menu_rm_qc_master" name="Configuration" parent="menu_rm_qc_root"
            sequence="80" groups="base.group_user" active="False"/>
  <menuitem id="menu_rm_qc_parameters" name="Test Templates" parent="menu_rm_qc_master"
            action="action_rm_qc_parameter" sequence="5"/>
  <menuitem id="menu_rm_qc_defects" name="Defect Catalog" parent="menu_rm_qc_master"
            action="action_rm_qc_defects" sequence="10"/>
  <menuitem id="menu_rm_qc_identification" name="Product Properties" parent="menu_rm_qc_master"
            action="action_rm_qc_identification_template" sequence="15"/>
  <menuitem id="menu_rm_qc_consumables" name="Department Consumables" parent="menu_rm_qc_master"
            action="action_rm_qc_consumable" sequence="20"/>

  <!-- Legacy Purchase Requests: kept (hidden) only for upgrade compatibility -->
  <menuitem id="menu_rm_qc_pr" name="Legacy Purchase Requests (Hidden)" parent="menu_rm_qc_root"
            action="action_rm_qc_pr" sequence="99" groups="base.group_no_one"/>
  <record id="menu_rm_qc_pr" model="ir.ui.menu"><field name="active" eval="False"/></record>

  <!-- Rewire existing native Quality menus, without adding duplicates.
       The originals are saved for uninstall restoration. -->
  <function model="ir.ui.menu" name="_rm_qc_place_quality_menus"/>
</odoo>
