<odoo>
  <record id="view_rm_qc_pr_list" model="ir.ui.view">
    <field name="name">rm.qc.purchase.request.list</field>
    <field name="model">rm.qc.purchase.request</field>
    <field name="arch" type="xml"><list string="Purchase Requisitions">
      <field name="name"/><field name="requested_on"/><field name="requested_by"/>
      <field name="origin_department"/><field name="partner_id"/><field name="state"/>
      <field name="purchase_order_id"/>
    </list></field>
  </record>
  <record id="view_rm_qc_pr_form" model="ir.ui.view">
    <field name="name">rm.qc.purchase.request.form</field>
    <field name="model">rm.qc.purchase.request</field>
    <field name="arch" type="xml">
      <form string="Purchase Requisition">
        <header>
          <button name="action_submit" type="object" string="Submit PR" class="btn-primary"
                  invisible="state != 'draft'" groups="quality_rm_spec_sampling.group_rm_qc_controller"/>
          <button name="action_approve" type="object" string="Manager Approve" class="btn-primary"
                  invisible="state != 'submitted'" groups="quality_rm_spec_sampling.group_rm_qc_pr_approver"/>
          <button name="action_create_rfq" type="object" string="Create RFQ" class="btn-primary"
                  invisible="state != 'approved'" groups="purchase.group_purchase_user"/>
          <button name="action_cancel" type="object" string="Cancel PR" invisible="state in ('cancelled','ordered')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,ordered"/>
        </header>
        <sheet><group><group><field name="name"/><field name="requested_on"/>
          <field name="requested_by"/><field name="origin_department"/></group>
          <group><field name="partner_id" readonly="state not in ('draft','approved')"/>
            <field name="company_id"/><field name="approved_by"/><field name="approved_on"/>
            <field name="purchase_order_id"/></group></group>
          <notebook><page string="Requisition Lines"><field name="line_ids" readonly="state != 'draft'">
            <list editable="bottom"><field name="product_id"/><field name="qc_required"/>
              <field name="quantity"/><field name="uom_id"/><field name="price_unit"/>
            </list></field></page>
            <page string="Notes"><field name="notes"/></page>
          </notebook>
          <chatter/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_rm_qc_pr" model="ir.actions.act_window">
    <field name="name">RM / Consumable Purchase Requisitions</field>
    <field name="res_model">rm.qc.purchase.request</field><field name="view_mode">list,form</field>
  </record>
</odoo>
