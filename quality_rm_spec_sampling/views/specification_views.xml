<odoo>
  <record id="view_rm_qc_template_list" model="ir.ui.view">
    <field name="name">rm.qc.parameter.template.list</field><field name="model">rm.qc.parameter.template</field>
    <field name="arch" type="xml"><list string="QC Master Parameters" create="true">
      <field name="scope"/><field name="process" optional="show"/><field name="category_text"/>
      <field name="item_text"/><field name="name"/><field name="lsl_text"/><field name="target_text"/>
      <field name="usl_text"/><field name="sample_size"/><field name="measurements_per_sample"/>
      <field name="inspection_frequency"/>
    </list></field>
  </record>
  <record id="view_rm_qc_template_form" model="ir.ui.view">
    <field name="name">rm.qc.parameter.template.form</field><field name="model">rm.qc.parameter.template</field>
    <field name="arch" type="xml"><form string="QC Master Parameter"><sheet>
      <group><group><field name="scope"/><field name="material_type"/><field name="process"/><field name="category_text"/>
        <field name="item_text"/><field name="name"/><field name="uom_text"/></group>
      <group><field name="lsl_text"/><field name="target_text"/><field name="usl_text"/>
        <field name="inspection_method"/><field name="inspection_level"/><field name="inspection_frequency"/></group></group>
      <group string="Sampling Procedure"><field name="lot_size"/><field name="sample_size"/>
        <field name="measurements_per_sample"/><field name="sample_method"/></group>
      <group string="Source Workbook"><field name="source_sheet"/><field name="source_row"/></group>
    </sheet></form></field>
  </record>
  <record id="view_rm_qc_defect_list" model="ir.ui.view">
    <field name="name">rm.qc.defect.list</field><field name="model">rm.qc.defect</field>
    <field name="arch" type="xml"><list string="RM Defect Catalog"><field name="code"/>
      <field name="name"/><field name="active"/></list></field>
  </record>
  <record id="view_rm_qc_defect_form" model="ir.ui.view">
    <field name="name">rm.qc.defect.form</field><field name="model">rm.qc.defect</field>
    <field name="arch" type="xml"><form string="RM Defect"><sheet><group>
      <field name="code"/><field name="name"/><field name="active"/>
    </group></sheet></form></field>
  </record>
  <record id="view_rm_qc_spec_list" model="ir.ui.view">
    <field name="name">rm.qc.specification.list</field><field name="model">rm.qc.specification</field>
    <field name="arch" type="xml"><list string="QC Specifications" decoration-success="state == 'approved'">
      <field name="name"/><field name="product_tmpl_id"/><field name="scope"/><field name="process"/>
      <field name="state"/><field name="approved_by"/><field name="approved_on"/><field name="company_id" optional="hide"/>
    </list></field>
  </record>
  <record id="view_rm_qc_spec_form" model="ir.ui.view">
    <field name="name">rm.qc.specification.form</field><field name="model">rm.qc.specification</field>
    <field name="arch" type="xml">
      <form string="QC Specification / TDS">
        <header>
          <button name="action_load_parameters" type="object" string="Load Master QC Parameters" class="btn-secondary"
                  invisible="state != 'draft'" groups="base.group_user"/>
          <button name="action_submit" type="object" string="Submit to QC Manager" class="btn-primary"
                  invisible="state != 'draft'" groups="base.group_user"/>
          <button name="action_approve" type="object" string="Confirm TDS / Sampling" class="btn-primary"
                  invisible="state != 'submitted'" groups="base.group_user"/>
          <button name="action_duplicate_draft" type="object" string="Duplicate / Revise" class="btn-secondary"/>
          <button name="action_archive_spec" type="object" string="Archive" invisible="state != 'approved'"
                  groups="base.group_user"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,archived"/>
        </header>
        <sheet><group><group><field name="name"/><field name="product_tmpl_id" readonly="state != 'draft'"/>
          <field name="scope" readonly="state != 'draft'"/><field name="process" readonly="state != 'draft'"/>
          <field name="company_id" readonly="state != 'draft'"/></group>
          <group><field name="controller_id"/><field name="intended_customer_id" readonly="state != 'draft'"/>
          <field name="approved_by"/><field name="approved_on"/></group></group>
          <notebook>
            <page string="TDS &amp; Sampling Parameters">
              <field name="line_ids" readonly="state != 'draft'">
                <list editable="bottom"><field name="sequence" widget="handle"/>
                  <field name="template_id" optional="hide"/><field name="name"/><field name="uom_text"/>
                  <field name="lsl_text"/><field name="target_text"/><field name="usl_text"/>
                  <field name="limit_mode"/><field name="nominal_set" optional="hide"/>
                  <field name="nominal_numeric" optional="hide"/>
                  <button name="action_resolve_nominal_limits" type="object" icon="fa-calculator" title="Resolve Nominal +/- Limits"/>
                  <field name="lsl_numeric" optional="hide"/>
                  <field name="usl_numeric" optional="hide"/><field name="inspection_method"/>
                  <field name="lot_size" optional="hide"/><field name="sample_size"/>
                  <field name="sample_count"/><field name="measurements_per_sample"/>
                  <field name="sample_method" optional="hide"/><field name="inspection_level" optional="hide"/>
                  <field name="inspection_frequency"/>
                </list>
              </field>
            </page>
            <page string="Intended Customer / Product"><group><field name="intended_use"/>
              <field name="notes"/></group></page>
          </notebook>
          <chatter/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_rm_qc_spec" model="ir.actions.act_window">
    <field name="name">RM / Production QC Specifications</field>
    <field name="res_model">rm.qc.specification</field><field name="view_mode">list,form</field>
  </record>
  <record id="action_rm_qc_parameter" model="ir.actions.act_window">
    <field name="name">QC Parameter Templates</field><field name="res_model">rm.qc.parameter.template</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_rm_qc_defects" model="ir.actions.act_window">
    <field name="name">RM Defect / Error Catalog</field><field name="res_model">rm.qc.defect</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
