<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_rm_qc_mrp_production_inherit" model="ir.ui.view">
    <field name="name">mrp.production.form.inherit.rm.qc.stages</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_rm_qc_create_production_checks" type="object"
                string="Production QC" class="btn-secondary" groups="base.group_user"/>
      </xpath>
    </field>
  </record>
  <record id="view_rm_qc_production_stage_wizard_form" model="ir.ui.view">
    <field name="name">rm.qc.production.stage.wizard.form</field>
    <field name="model">rm.qc.production.stage.wizard</field>
    <field name="arch" type="xml">
      <form string="Production QC">
        <group>
          <field name="production_id" readonly="1"/>
          <field name="stage" required="1"/>
        </group>
        <footer>
          <button name="action_open_check" type="object" string="Open QC Check" class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
