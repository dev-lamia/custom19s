<odoo>

  <!-- ================================================================
       SINGLE MEASUREMENT ROW (rarely opened on its own)
       ================================================================ -->
  <record id="view_rm_qc_log_form" model="ir.ui.view">
    <field name="name">rm.qc.inspection.log.form</field>
    <field name="model">rm.qc.inspection.log</field>
    <field name="arch" type="xml">
      <form string="Measurement">
        <sheet>
          <group>
            <group string="Which sample?">
              <field name="sample_no" string="Sample / Roll #"/>
              <field name="measure_no" string="Test #"/>
            </group>
            <group string="Result">
              <field name="value_text" string="Measured Result"/>
              <field name="manual_result" string="Pass / Fail (manual)"/>
              <field name="result" widget="badge" readonly="1"
                     decoration-success="result == 'pass'"
                     decoration-danger="result in ('out_of_spec', 'fail')"
                     decoration-muted="result == 'pending'"/>
              <field name="allowed_defect_ids" invisible="1"/>
              <field name="defect_id" string="Catalog Error"
                     required="result in ('out_of_spec', 'fail')"
                     options="{'no_create': True, 'no_open': True}"/>
              <field name="observation" string="Notes"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ================================================================
       "ENTER RESULTS" POPUP  (one test, all its samples)
       ================================================================ -->
  <record id="view_rm_qc_inspection_parameter_form" model="ir.ui.view">
    <field name="name">rm.qc.inspection.parameter.form</field>
    <field name="model">rm.qc.inspection.parameter</field>
    <field name="arch" type="xml">
      <form string="Enter Results">
        <header>
          <button name="action_generate_measurements" type="object"
                  string="Add Missing Rows" class="btn-secondary"
                  invisible="inspection_scope == 'incoming'"
                  help="Use this after changing the number of samples."/>
        </header>
        <sheet>
          <div class="oe_title o_rm_qc_title">
            <h1><field name="name" readonly="1"/></h1>
            <div class="o_rm_qc_sub" style="max-width: 24rem;">
              <field name="progress" widget="progressbar"/>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-1">
              <span class="badge rounded-pill text-bg-success fw-normal">Pass <b><field name="pass_count" class="oe_inline"/></b></span>
              <span class="badge rounded-pill text-bg-danger fw-normal">Out of Spec <b><field name="oos_count" class="oe_inline"/></b></span>
              <span class="badge rounded-pill text-bg-danger fw-normal">Fail <b><field name="fail_count" class="oe_inline"/></b></span>
              <span class="badge rounded-pill text-bg-secondary fw-normal">Pending <b><field name="pending_count" class="oe_inline"/></b></span>
            </div>
          </div>

          <div class="o_rm_qc_lot_hint" invisible="inspection_scope != 'incoming'">
            Samples follow the actual Lot/Serial numbers on this receipt.
            Tests per sample are kept from the configured QC Standard.
          </div>
          <group>
            <group string="Allowed range (from TDS)">
              <field name="limit_display" string="Allowed" class="fw-bold"/>
              <field name="limit_type" string="Limit type"/>
              <field name="target_text" string="TDS Target"/>
              <field name="lsl_numeric" invisible="1"/>
              <field name="usl_numeric" invisible="1"/>
              <field name="uom_text" invisible="1"/>
              <field name="lsl_text" invisible="1"/>
              <field name="usl_text" invisible="1"/>
            </group>
            <group string="How many to check">
              <field name="inspection_scope" invisible="1"/>
              <field name="samples_to_test" string="Lot / Serial samples"
                     readonly="inspection_scope == 'incoming'"
                     invisible="inspection_scope != 'incoming'"/>
              <field name="samples_to_test" string="Samples to check"
                     invisible="inspection_scope == 'incoming'"/>
              <field name="measurements_per_sample" string="Tests per sample"/>
              <field name="sample_size" string="Sampling rule"/>
              <field name="limit_mode" invisible="1"/>
            </group>
          </group>

          <div class="alert alert-info py-2" role="status" invisible="limit_mode != 'numeric'">
            Type the measured number. It turns red when outside the range; then choose the Catalog Error.
            When every reading is within range the inspection passes automatically.
          </div>
          <div class="alert alert-warning py-2" role="status" invisible="limit_mode == 'numeric'">
            This test is judged by eye. Type what you saw, then choose <b>Pass</b> or <b>Fail</b>.
            A <b>Fail</b> needs a Catalog Error.
          </div>

          <field name="expected_count" invisible="1"/>
          <field name="entered_count" invisible="1"/>
          <field name="failed_count" invisible="1"/>

          <field name="log_ids" nolabel="1">
            <list editable="bottom"
                  decoration-danger="result in ('out_of_spec', 'fail')">
              <field name="sample_no" string="Sample"/>
              <field name="measure_no" string="Test #"/>
              <field name="value_text" string="Measured Result"/>
              <field name="manual_result" string="Pass / Fail"
                     column_invisible="parent.limit_mode == 'numeric'"/>
              <field name="result" string="Result" widget="badge" readonly="1"
                     decoration-success="result == 'pass'"
                     decoration-danger="result in ('out_of_spec', 'fail')"
                     decoration-muted="result == 'pending'"/>
              <field name="allowed_defect_ids" column_invisible="1"/>
              <field name="defect_id" string="Catalog Error"
                     required="result in ('out_of_spec', 'fail')"
                     options="{'no_create': True, 'no_open': True}"/>
              <field name="observation" string="Notes" optional="hide"/>
            </list>
          </field>

          <notebook>
            <page string="More sampling details" name="details">
              <group>
                <group>
                  <field name="quality_check_id" readonly="1"/>
                  <field name="lot_size"/>
                  <field name="inspection_method"/>
                </group>
                <group>
                  <field name="sample_method"/>
                  <field name="inspection_level"/>
                  <field name="inspection_frequency"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_rm_qc_inspection_parameter_list" model="ir.ui.view">
    <field name="name">rm.qc.inspection.parameter.list</field>
    <field name="model">rm.qc.inspection.parameter</field>
    <field name="arch" type="xml">
      <list string="Tests">
        <field name="name" string="Test"/>
        <field name="limit_display" string="Allowed"/>
        <field name="samples_to_test" string="Samples"/>
        <field name="measurements_per_sample" string="Tests / Sample"/>
        <field name="progress" widget="progressbar"/>
      </list>
    </field>
  </record>

  <!-- ================================================================
       QC INSPECTIONS
       ================================================================ -->
  <record id="view_rm_qc_quality_check_list" model="ir.ui.view">
    <field name="name">quality.check.rm.qc.detailed.list</field>
    <field name="model">quality.check</field>
    <field name="arch" type="xml">
      <list string="Quality Inspection" create="true" sample="1">
        <field name="name" readonly="1" string="Inspection"/>
        <field name="product_id"/>
        <field name="picking_id" string="Receipt"/>
        <field name="lot_ids" widget="many2many_tags" string="Lot / Batch"/>
        <field name="rm_qc_specification_id" string="QC Standard" optional="hide"/>
        <field name="rm_qc_inspector_id" widget="many2one_avatar_user" optional="show"/>
        <field name="rm_qc_progress" widget="progressbar" string="Progress"/>
        <field name="rm_qc_reading_total" string="Readings" optional="show"/>
        <field name="rm_qc_pass_count" string="Pass" optional="show"
               decoration-success="rm_qc_pass_count &gt; 0"/>
        <field name="rm_qc_oos_count" string="Out of Spec" optional="show"
               decoration-danger="rm_qc_oos_count &gt; 0"/>
        <field name="rm_qc_fail_count" string="Fail" optional="show"
               decoration-danger="rm_qc_fail_count &gt; 0"/>
        <field name="rm_qc_pending_count" string="Pending" optional="show"
               decoration-muted="rm_qc_pending_count &gt; 0"/>
        <field name="rm_qc_test_fail_count" string="Tests Not OK" optional="hide"/>
        <field name="quality_state" widget="badge" string="Status"
               decoration-info="quality_state == 'none'"
               decoration-success="quality_state == 'pass'"
               decoration-danger="quality_state == 'fail'"/>
      </list>
    </field>
  </record>

  <record id="view_rm_qc_quality_check_kanban" model="ir.ui.view">
    <field name="name">quality.check.rm.qc.detailed.kanban</field>
    <field name="model">quality.check</field>
    <field name="arch" type="xml">
      <kanban class="o_rm_qc_card" default_group_by="quality_state" group_create="false"
              records_draggable="false" quick_create="false" sample="1">
        <templates>
          <t t-name="card">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <field name="product_id" class="o_rm_qc_card_title"/>
              <field name="rm_qc_inspector_id" widget="many2one_avatar_user"/>
            </div>
            <div class="o_rm_qc_card_meta mt-1">
              <field name="name"/>
              <span t-if="record.picking_id.raw_value"> - <field name="picking_id"/></span>
            </div>
            <div class="o_rm_qc_card_meta" t-if="record.lot_ids.raw_value.length">
              <field name="lot_ids" widget="many2many_tags"/>
            </div>
            <div class="mt-2">
              <field name="rm_qc_progress" widget="progressbar"/>
            </div>
            <field name="quality_state" invisible="1"/>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_rm_qc_quality_check_search" model="ir.ui.view">
    <field name="name">quality.check.rm.qc.search</field>
    <field name="model">quality.check</field>
    <field name="arch" type="xml">
      <search string="Search Quality Inspections">
        <field name="name" string="Inspection"/>
        <field name="product_id"/>
        <field name="picking_id" string="Receipt"/>
        <field name="lot_ids" string="Lot / Batch"/>
        <field name="rm_qc_inspector_id" string="Inspector"/>
        <filter name="filter_mine" string="My Inspections"
                domain="[('rm_qc_inspector_id', '=', uid)]"/>
        <separator/>
        <filter name="filter_todo" string="To Do" domain="[('quality_state', '=', 'none')]"/>
        <filter name="filter_pass" string="Passed" domain="[('quality_state', '=', 'pass')]"/>
        <filter name="filter_fail" string="Failed" domain="[('quality_state', '=', 'fail')]"/>
        <separator/>
        <filter name="filter_incoming" string="Incoming Material" domain="[('rm_qc_scope', '=', 'incoming')]"/>
        <filter name="filter_production" string="Production" domain="[('rm_qc_scope', '=', 'production')]"/>
        <group>
          <filter name="group_status" string="Status" context="{'group_by': 'quality_state'}"/>
          <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
          <filter name="group_inspector" string="Inspector" context="{'group_by': 'rm_qc_inspector_id'}"/>
          <filter name="group_scope" string="Scope" context="{'group_by': 'rm_qc_scope'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_rm_qc_quality_check_form" model="ir.ui.view">
    <field name="name">quality.check.rm.qc.detailed.form</field>
    <field name="model">quality.check</field>
    <field name="arch" type="xml">
      <form string="Quality Inspection">
        <header>
          <button name="action_rm_qc_load_specification" type="object" string="Load QC Tests"
                  class="btn-secondary"
                  invisible="quality_state in ('pass', 'fail') or rm_qc_parameter_line_ids"/>
          <button name="do_pass" type="object" string="Pass" class="btn-primary"
                  invisible="quality_state in ('pass', 'fail')"/>
          <button name="do_fail" type="object" string="Fail" class="btn-outline-danger"
                  invisible="quality_state in ('pass', 'fail')"/>
          <field name="quality_state" widget="statusbar"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Passed" bg_color="text-bg-success"
                  invisible="quality_state != 'pass'"/>
          <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger"
                  invisible="quality_state != 'fail'"/>

          <div class="oe_title o_rm_qc_title">
            <h1><field name="product_id" placeholder="Product" options="{'no_create': True}"/></h1>
            <div class="o_rm_qc_sub"><field name="name" readonly="1"/></div>
          </div>

          <group>
            <group>
              <field name="picking_id" string="Receipt" invisible="rm_qc_scope == 'production'"/>
              <field name="lot_ids" string="Lot / Batch" widget="many2many_tags"
                     invisible="rm_qc_scope == 'production'"/>
              <field name="rm_qc_po_reference" string="PO Number"
                     invisible="rm_qc_scope == 'production' or not rm_qc_po_reference"/>
              <field name="rm_qc_production_id" string="Manufacturing Order"
                     invisible="rm_qc_scope != 'production'"/>
              <field name="rm_qc_stage" string="Production Stage"
                     invisible="rm_qc_scope != 'production'"/>
            </group>
            <group>
              <field name="rm_qc_specification_id" string="QC Standard"/>
              <field name="rm_qc_inspector_id" string="Inspector"/>
              <field name="rm_qc_progress" widget="progressbar" string="Results entered"/>
            </group>
          </group>

          <div class="alert alert-danger py-2" role="alert"
               invisible="rm_qc_failed_count == 0 or quality_state in ('pass', 'fail')">
            <field name="rm_qc_failed_count" class="oe_inline fw-bold"/>
            reading(s) are outside the allowed range. Re-check, or click <b>Fail</b>. A failed inspection blocks receipt validation.
          </div>

          <div class="o_rm_qc_help" invisible="quality_state in ('pass', 'fail')">
            Click <b>Enter Results</b> on a test to type its measurements.
          </div>
          <field name="rm_qc_parameter_line_ids" nolabel="1"
                 readonly="quality_state in ('pass', 'fail')">
            <list decoration-danger="failed_count &gt; 0"
                  decoration-success="progress &gt;= 100 and failed_count == 0"
                  decoration-muted="samples_to_test &lt;= 0">
              <field name="name" string="Test"/>
              <field name="limit_display" string="Allowed"/>
              <field name="target_text" string="TDS Target" optional="hide"/>
              <field name="samples_to_test" string="Samples"/>
              <field name="measurements_per_sample" string="Tests / Sample" optional="hide"/>
              <field name="progress" widget="progressbar"/>
              <field name="pass_count" string="Pass" decoration-success="pass_count &gt; 0"/>
              <field name="oos_count" string="Out of Spec" decoration-danger="oos_count &gt; 0"/>
              <field name="fail_count" string="Fail" decoration-danger="fail_count &gt; 0"/>
              <field name="pending_count" string="Pending" optional="show"/>
              <field name="test_result" string="Result" widget="badge"
                     decoration-success="test_result == 'pass'"
                     decoration-danger="test_result == 'fail'"
                     decoration-muted="test_result == 'pending'"/>
              <field name="failed_count" column_invisible="1"/>
              <button name="action_open_measurement_logs" type="object" string="Enter Results"
                      icon="fa-pencil-square-o" class="btn-primary"
                      invisible="progress &gt;= 100"/>
              <button name="action_open_measurement_logs" type="object" string="View"
                      icon="fa-eye" class="btn-link"
                      invisible="progress &lt; 100"/>
            </list>
          </field>

          <notebook>
            <page string="Notes" name="notes">
              <field name="rm_qc_review_notes" nolabel="1"
                     placeholder="Anything the next person should know..."/>
            </page>
            <page string="More details" name="extra">
              <group>
                <group>
                  <field name="rm_qc_scope" string="Inspection Type"/>
                  <field name="rm_qc_batch_reference" string="Batch Number"/>
                  <field name="rm_qc_date" string="Inspection Date"/>
                </group>
                <group>
                  <field name="company_id" groups="base.group_multi_company"/>
                  <field name="title"/>
                  <field name="test_type_id" string="Odoo Check Type"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ================================================================
       RM QC ANALYSIS (one row per reading)
       ================================================================ -->
  <record id="view_rm_qc_log_analysis_list" model="ir.ui.view">
    <field name="name">rm.qc.inspection.log.analysis.list</field>
    <field name="model">rm.qc.inspection.log</field>
    <field name="arch" type="xml">
      <list string="RM QC Readings" create="false" edit="false" delete="false"
            decoration-danger="result in ('out_of_spec', 'fail')"
            decoration-success="result == 'pass'">
        <field name="inspection_date"/>
        <field name="picking_id"/>
        <field name="partner_id" optional="show"/>
        <field name="product_id"/>
        <field name="batch_reference"/>
        <field name="test_name"/>
        <field name="sample_no" string="Sample"/>
        <field name="measure_no" string="Test #"/>
        <field name="value_text" string="Value"/>
        <field name="result" widget="badge"
               decoration-success="result == 'pass'"
               decoration-danger="result in ('out_of_spec', 'fail')"
               decoration-muted="result == 'pending'"/>
        <field name="defect_id"/>
        <field name="check_state" optional="hide"/>
        <field name="inspector_id" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_rm_qc_log_analysis_pivot" model="ir.ui.view">
    <field name="name">rm.qc.inspection.log.analysis.pivot</field>
    <field name="model">rm.qc.inspection.log</field>
    <field name="arch" type="xml">
      <pivot string="RM QC Readings" sample="1">
        <field name="test_name" type="row"/>
        <field name="result" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="view_rm_qc_log_analysis_graph" model="ir.ui.view">
    <field name="name">rm.qc.inspection.log.analysis.graph</field>
    <field name="model">rm.qc.inspection.log</field>
    <field name="arch" type="xml">
      <graph string="RM QC Readings" type="bar" stacked="1" sample="1">
        <field name="test_name"/>
        <field name="result"/>
      </graph>
    </field>
  </record>

  <record id="view_rm_qc_log_analysis_search" model="ir.ui.view">
    <field name="name">rm.qc.inspection.log.analysis.search</field>
    <field name="model">rm.qc.inspection.log</field>
    <field name="arch" type="xml">
      <search string="Search RM QC Readings">
        <field name="product_id"/>
        <field name="batch_reference"/>
        <field name="partner_id"/>
        <field name="picking_id"/>
        <field name="test_name"/>
        <field name="defect_id"/>
        <filter name="entered" string="Entered" domain="[('result', '!=', 'pending')]"/>
        <separator/>
        <filter name="res_pass" string="Pass" domain="[('result', '=', 'pass')]"/>
        <filter name="res_oos" string="Out of Spec" domain="[('result', '=', 'out_of_spec')]"/>
        <filter name="res_fail" string="Fail" domain="[('result', '=', 'fail')]"/>
        <filter name="res_bad" string="Not OK (Out of Spec + Fail)"
                domain="[('result', 'in', ('out_of_spec', 'fail'))]"/>
        <separator/>
        <filter name="incoming" string="Incoming RM" domain="[('scope', '=', 'incoming')]"/>
        <filter name="inspection_date" string="Inspection Date" date="inspection_date"/>
        <group>
          <filter name="by_test" string="Test" context="{'group_by': 'test_name'}"/>
          <filter name="by_result" string="Result" context="{'group_by': 'result'}"/>
          <filter name="by_defect" string="Catalog Error" context="{'group_by': 'defect_id'}"/>
          <filter name="by_product" string="Product" context="{'group_by': 'product_id'}"/>
          <filter name="by_batch" string="Lot / Batch" context="{'group_by': 'batch_reference'}"/>
          <filter name="by_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
          <filter name="by_receipt" string="Receipt" context="{'group_by': 'picking_id'}"/>
          <filter name="by_month" string="Month" context="{'group_by': 'inspection_date:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_rm_qc_analysis" model="ir.actions.act_window">
    <field name="name">RM QC Analysis</field>
    <field name="res_model">rm.qc.inspection.log</field>
    <field name="view_mode">pivot,graph,list</field>
    <field name="search_view_id" ref="view_rm_qc_log_analysis_search"/>
    <field name="context">{'search_default_entered': 1, 'search_default_incoming': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No readings yet</p>
      <p>Every reading entered in an RM inspection appears here: count Pass, Out of Spec and
         Fail by test, product, lot, vendor or catalog error.</p>
    </field>
  </record>
  <record id="action_rm_qc_analysis_pivot" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_rm_qc_analysis"/>
    <field name="view_mode">pivot</field><field name="view_id" ref="view_rm_qc_log_analysis_pivot"/>
    <field name="sequence">1</field>
  </record>
  <record id="action_rm_qc_analysis_graph" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_rm_qc_analysis"/>
    <field name="view_mode">graph</field><field name="view_id" ref="view_rm_qc_log_analysis_graph"/>
    <field name="sequence">2</field>
  </record>
  <record id="action_rm_qc_analysis_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_rm_qc_analysis"/>
    <field name="view_mode">list</field><field name="view_id" ref="view_rm_qc_log_analysis_list"/>
    <field name="sequence">3</field>
  </record>

  <!-- ================================================================
       ACTIONS
       ================================================================ -->
  <record id="action_rm_qc_detailed_check" model="ir.actions.act_window">
    <field name="name">Quality Inspection</field>
    <field name="res_model">quality.check</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[]</field>
    <field name="search_view_id" ref="view_rm_qc_quality_check_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No inspections yet</p>
      <p>Open a Receipt (or a Manufacturing Order) and click the QC button.
         The inspection appears here with all its tests ready to fill in.</p>
    </field>
  </record>
  <record id="action_rm_qc_detailed_list_view" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_rm_qc_detailed_check"/>
    <field name="view_mode">list</field><field name="view_id" ref="view_rm_qc_quality_check_list"/>
    <field name="sequence">1</field>
  </record>
  <record id="action_rm_qc_detailed_kanban_view" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_rm_qc_detailed_check"/>
    <field name="view_mode">kanban</field><field name="view_id" ref="view_rm_qc_quality_check_kanban"/>
    <field name="sequence">2</field>
  </record>
  <record id="action_rm_qc_detailed_form_view" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_rm_qc_detailed_check"/>
    <field name="view_mode">form</field><field name="view_id" ref="view_rm_qc_quality_check_form"/>
    <field name="sequence">3</field>
  </record>
  <record id="action_rm_qc_all_checks" model="ir.actions.act_window">
    <field name="name">Quality Checks (incl. Manual)</field>
    <field name="res_model">quality.check</field><field name="view_mode">list,form</field>
  </record>
</odoo>
