<odoo>
  <record id="view_rm_qc_consumable_list" model="ir.ui.view">
    <field name="name">rm.qc.consumable.allocation.list</field>
    <field name="model">rm.qc.consumable.allocation</field>
    <field name="arch" type="xml">
      <list string="Department Consumables" sample="1">
        <field name="name" string="Consumable"/>
        <field name="cadence" widget="badge"
               decoration-info="cadence == 'rop'"
               decoration-success="cadence == 'once'"
               decoration-warning="cadence == 'mixed'"/>
        <field name="printing"/><field name="lamination"/><field name="slitting"/>
        <field name="pouching"/><field name="valving"/><field name="production"/>
        <field name="planning"/><field name="quality"/><field name="sales"/>
        <field name="stores"/><field name="inks"/><field name="prepress"/>
      </list>
    </field>
  </record>

  <record id="view_rm_qc_consumable_search" model="ir.ui.view">
    <field name="name">rm.qc.consumable.allocation.search</field>
    <field name="model">rm.qc.consumable.allocation</field>
    <field name="arch" type="xml">
      <search string="Search Consumables">
        <field name="name" string="Consumable"/>
        <filter name="filter_printing" string="Printing" domain="[('printing', '=', True)]"/>
        <filter name="filter_lamination" string="Lamination" domain="[('lamination', '=', True)]"/>
        <filter name="filter_slitting" string="Slitting" domain="[('slitting', '=', True)]"/>
        <filter name="filter_pouching" string="Pouching" domain="[('pouching', '=', True)]"/>
        <filter name="filter_stores" string="Stores" domain="[('stores', '=', True)]"/>
        <group>
          <filter name="group_cadence" string="Cadence" context="{'group_by': 'cadence'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_rm_qc_consumable_form" model="ir.ui.view">
    <field name="name">rm.qc.consumable.allocation.form</field>
    <field name="model">rm.qc.consumable.allocation</field>
    <field name="arch" type="xml">
      <form string="Department Consumable">
        <sheet>
          <div class="oe_title o_rm_qc_title">
            <label for="name"/>
            <h1><field name="name" placeholder="Consumable name"/></h1>
          </div>
          <group>
            <group>
              <field name="cadence"/>
            </group>
            <group>
              <field name="note"/>
            </group>
          </group>
          <group string="Which departments use it?">
            <group>
              <field name="printing" widget="boolean_toggle"/>
              <field name="lamination" widget="boolean_toggle"/>
              <field name="slitting" widget="boolean_toggle"/>
              <field name="pouching" widget="boolean_toggle"/>
              <field name="valving" widget="boolean_toggle"/>
              <field name="prepress" widget="boolean_toggle"/>
            </group>
            <group>
              <field name="production" widget="boolean_toggle"/>
              <field name="planning" widget="boolean_toggle"/>
              <field name="quality" widget="boolean_toggle"/>
              <field name="sales" widget="boolean_toggle"/>
              <field name="stores" widget="boolean_toggle"/>
              <field name="inks" widget="boolean_toggle"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_rm_qc_consumable" model="ir.actions.act_window">
    <field name="name">Department Consumables</field>
    <field name="res_model">rm.qc.consumable.allocation</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_rm_qc_consumable_search"/>
  </record>
</odoo>
