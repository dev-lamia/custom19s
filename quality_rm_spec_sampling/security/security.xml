<odoo>
  <record id="module_category_rm_qc" model="ir.module.category">
    <field name="name">RM Quality Extension</field>
    <field name="sequence">40</field>
  </record>
  <record id="privilege_rm_qc" model="res.groups.privilege">
    <field name="name">RM QC Extension</field>
    <field name="category_id" ref="module_category_rm_qc"/>
  </record>
  <record id="group_rm_qc_inspector" model="res.groups">
    <field name="name">QC Inspector</field>
    <field name="privilege_id" ref="privilege_rm_qc"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_rm_qc_controller" model="res.groups">
    <field name="name">QC Controller / Planner</field>
    <field name="privilege_id" ref="privilege_rm_qc"/>
    <field name="implied_ids" eval="[(4, ref('group_rm_qc_inspector'))]"/>
  </record>
  <record id="group_rm_qc_manager" model="res.groups">
    <field name="name">QC Manager</field>
    <field name="privilege_id" ref="privilege_rm_qc"/>
    <field name="implied_ids" eval="[(4, ref('group_rm_qc_controller'))]"/>
  </record>
  <record id="rule_qc_spec_company" model="ir.rule">
    <field name="name">QC Specification: allowed companies</field>
    <field name="model_id" ref="model_rm_qc_specification"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
