<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Read-only raw biometric attendance list. Source evidence must not be manually created or edited. -->
    <record id="machine_attendance_view_tree" model="ir.ui.view">
        <field name="name">zk.machine.attendance.view.tree</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance Analysis" create="false" edit="false" delete="false">
                <field name="punching_time" widget="datetime" options="{&quot;show_seconds&quot;: true}"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="device_user_name" string="Device User Name" optional="show"/>
                <field name="device_id"/>
                <field name="device_id_num" string="Biometric ID"/>
                <field name="device_location" string="Location" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="punch_type"/>
                <field name="attendance_type"/>
            </list>
        </field>
    </record>
    <!-- Read-only raw punch inspection form. -->
    <record id="machine_attendance_view_form" model="ir.ui.view">
        <field name="name">zk.machine.attendance.view.form</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <form string="Raw Biometric Punch" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="punching_time"/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="device_user_name" string="Device User Name" readonly="1"/>
                            <field name="device_id"/>
                            <field name="device_location" string="Location"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="device_id_num" string="Biometric ID"/>
                            <field name="punch_type"/>
                            <field name="attendance_type"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">Raw device evidence is read-only. Map the matching Device User to link an employee, then use the controlled historical mapping tool if derived attendance needs rebuilding.</div>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Native search/date/group filters for attendance analysis. -->
    <record id="machine_attendance_view_search" model="ir.ui.view">
        <field name="name">zk.machine.attendance.view.search</field>
        <field name="model">zk.machine.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance Logs">
                <field name="employee_id"/>
                <field name="device_id_num" string="Biometric ID"/>
                <field name="device_id"/>
                <field name="device_location" string="Location"/>
                <field name="company_id" string="Company"/>
                <field name="punching_time"/>
                <filter string="Unmapped" name="unmapped" domain="[('employee_id', '=', False)]"/>
                <filter string="Mapped" name="mapped" domain="[('employee_id', '!=', False)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('punching_time', '&gt;=', 'today'), ('punching_time', '&lt;', 'today +1d')]"/>
                <filter string="Yesterday" name="yesterday" domain="[('punching_time', '&gt;=', 'today -1d'), ('punching_time', '&lt;', 'today')]"/>
                <filter string="Date" name="punching_time_filter" date="punching_time"/>
                <group>
                    <filter string="Company" name="group_company" context="{&quot;group_by&quot;: &quot;company_id&quot;}"/>
                    <filter string="Location" name="group_location" context="{&quot;group_by&quot;: &quot;device_location&quot;}"/>
                    <filter string="Employee" name="group_employee" context="{&quot;group_by&quot;: &quot;employee_id&quot;}"/>
                    <filter string="Device" name="group_device" context="{&quot;group_by&quot;: &quot;device_id&quot;}"/>
                    <filter string="Biometric ID" name="group_pin" context="{&quot;group_by&quot;: &quot;device_id_num&quot;}"/>
                    <filter string="Device User Name" name="group_device_user" groups="tam_hr_zk_attendance.group_biometric_manager" context="{&quot;group_by&quot;: &quot;device_user_id&quot;}"/>
                    <filter string="Day" name="group_day" context="{&quot;group_by&quot;: &quot;punching_time:day&quot;}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- Attendance Analysis action; list/form are read-only. -->
    <record id="machine_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">zk.machine.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="machine_attendance_view_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
