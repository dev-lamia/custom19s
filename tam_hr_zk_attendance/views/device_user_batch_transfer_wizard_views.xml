<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zk_device_user_batch_transfer_wizard_form" model="ir.ui.view">
        <field name="name">zk.device.user.batch.transfer.wizard.form</field>
        <field name="model">zk.device.user.batch.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Selected Device Users" create="false" delete="false">
                <sheet>
                    <group>
                        <group string="Selected Source Users">
                            <field name="source_device_id"/>
                            <field name="selected_count"/>
                            <field name="device_user_ids" widget="many2many_tags" readonly="1"/>
                            <field name="permitted_device_company_ids" invisible="1"/>
                        </group>
                        <group string="Destination">
                            <field name="target_device_id" required="1"
                                   domain="[('is_approved', '=', True), ('company_id', 'in', permitted_device_company_ids)]"
                                   context="{'allowed_company_ids': permitted_device_company_ids}"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="source_is_security_push" invisible="1"/>
                            <field name="include_profile"/>
                            <field name="include_fingerprints"/>
                            <field name="include_face"/>
                            <field name="include_photo"/>
                            <field name="include_readback"/>
                            <field name="include_access" invisible="not source_is_security_push"/>
                            <field name="authorization_group_id" invisible="not source_is_security_push or not include_profile" required="source_is_security_push and include_profile"/>
                            <field name="authorization_timezone_id" invisible="not source_is_security_push or not include_access" required="source_is_security_push and include_access"/>
                            <field name="authorization_door_id" invisible="not source_is_security_push or not include_access" required="source_is_security_push and include_access"/>
                        </group>
                    </group>
                    <group string="Confirmation">
                        <field name="confirm_transfer"/>
                    </group>
                    <div class="text-muted">Only checked operations are queued. Target inventory is checked first; any conflicting PIN stops the whole batch. Profile photos and face templates are separate.</div>
                </sheet>
                <footer>
                    <button name="action_transfer" string="Transfer Selected Users" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
