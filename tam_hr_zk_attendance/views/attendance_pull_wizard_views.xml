<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Attendance pull wizard. The selected date range is independent from the per-request batch size. -->
    <record id="zk_attendance_pull_wizard_view_form" model="ir.ui.view">
        <field name="name">zk.attendance.pull.wizard.form</field>
        <field name="model">zk.attendance.pull.wizard</field>
        <field name="arch" type="xml">
            <form string="Pull Attendance from Device">
                <group>
                    <field name="device_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="batch_days"/>
                </group>
                <div class="alert alert-info" role="alert">Choose the full attendance period above. Long periods are requested in smaller sections for reliability; the request range does not change the dates you selected.</div>
                <footer>
                    <button name="action_queue" string="Queue Pull" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
