<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="group_biometric_user" model="res.groups"><field name="name">Biometric Operator</field></record>
  <record id="group_biometric_manager" model="res.groups"><field name="name">Biometric Manager</field><field name="implied_ids" eval="[(4, ref('group_biometric_user'))]"/></record>

  <!-- No employees or operator/manager groups inherit this role.
       Biometric storage is accessed only through audited server-side sudo()
       protocol methods; this unassigned group provides an explicit ACL entry
       without exposing sensitive fingerprint/template bytes through RPC. -->
  <record id="group_biometric_protocol_internal" model="res.groups">
    <field name="name">Private Biometric Protocol Service (Do Not Assign)</field>
    <field name="comment">Reserved for internal biometric protocol operations; do not assign this group to people. Device synchronization currently uses narrowly scoped sudo() server-side processing.</field>
  </record>

  <record id="rule_zk_device_company" model="ir.rule"><field name="name">Biometric device multi-company</field><field name="model_id" ref="model_zk_device"/><field name="domain_force"><![CDATA[[('company_id', 'in', company_ids)]]]></field><field name="groups" eval="[(4, ref('group_biometric_user'))]"/></record>
  <record id="rule_zk_device_user_company" model="ir.rule"><field name="name">Biometric device user multi-company</field><field name="model_id" ref="model_zk_device_user"/><field name="domain_force"><![CDATA[[('company_id', 'in', company_ids)]]]></field><field name="groups" eval="[(4, ref('group_biometric_user'))]"/></record>
  <record id="rule_zk_device_command_company" model="ir.rule"><field name="name">Biometric command multi-company</field><field name="model_id" ref="model_zk_device_command"/><field name="domain_force"><![CDATA[[('company_id', 'in', company_ids)]]]></field><field name="groups" eval="[(4, ref('group_biometric_user'))]"/></record>
  <record id="rule_zk_machine_attendance_company" model="ir.rule"><field name="name">Biometric raw log multi-company</field><field name="model_id" ref="model_zk_machine_attendance"/><field name="domain_force"><![CDATA[[('company_id', 'in', company_ids)]]]></field><field name="groups" eval="[(4, ref('group_biometric_user'))]"/></record>
</odoo>
