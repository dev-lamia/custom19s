<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_submit_wizard_form" model="ir.ui.view">
        <field name="name">sale.finance.payment.submit.wizard.form</field>
        <field name="model">sale.finance.payment.submit.wizard</field>
        <field name="arch" type="xml">
            <form string="Submit Advance Payment Proof">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount" required="1"/>
                    <field name="payment_reference"/>
                    <field name="payment_proof" filename="payment_filename" required="1"/>
                    <field name="payment_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Submit to Finance"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
