<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_sale_finance_approval" model="res.groups.privilege">
        <field name="name">Finance Sales Approval</field>
    </record>
    <record id="group_finance_approver" model="res.groups">
        <field name="name">Finance Approver</field>
        <field name="privilege_id" ref="privilege_sale_finance_approval"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Can verify advance payment, confirm quotations, create Sales Order invoices, and release production.</field>
    </record>
</odoo>
