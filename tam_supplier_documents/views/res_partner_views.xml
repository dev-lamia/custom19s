<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_vendor_documents" model="ir.ui.view">
        <field name="name">res.partner.form.vendor.documents</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Add new tab in notebook -->
            <xpath expr="//form//notebook" position="inside">
                <page string="Vendor Documents"
                      name="vendor_documents_page"
                      invisible="supplier_rank &lt;= 0">

                    <group>
                        <field name="vendor_document_ids" nolabel="1">
                            <list editable="bottom" default_order="sequence asc,id desc">
                                <field name="sequence" widget="handle"/>
                                <field name="type_id"
                                    context="{'default_vendor_ok': True,
                                                'default_sale_ok': False,
                                                'default_purchase_ok': False}"/>
                                <field name="file"
                                       filename="file_filename"
                                       widget="download"
                                       string="File"/>
                                <field name="expiry_date"/>
                                <field name="department_id" optional="show"/>
                                <field name="stop_notifications" optional="show"/>
                            </list>

                            <form string="Vendor Document">
                                <sheet>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="type_id"
                                            context="{'default_vendor_ok': True,
                                                        'default_sale_ok': False,
                                                        'default_purchase_ok': False}"/>
                                        <field name="file"
                                               filename="file_filename"
                                               widget="download"
                                               string="File"/>
                                        <field name="file_filename" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="expiry_date"/>
                                        <field name="department_id"/>
                                        <field name="stop_notifications"/>
                                        <field name="last_notified_on" readonly="1"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>

                </page>
            </xpath>

        </field>
    </record>
</odoo>
