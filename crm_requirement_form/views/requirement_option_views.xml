        <field name="name">crm.requirement.fg.type.form</field>
        <field name="model">crm.requirement.fg.type</field>
        <field name="arch" type="xml">
            <form string="FG Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="behavior"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

