    <record id="crm_requirement_fg_type_list" model="ir.ui.view">
        <field name="name">crm.requirement.fg.type.list</field>
        <field name="model">crm.requirement.fg.type</field>
        <field name="arch" type="xml">
            <list string="FG Types" editable="bottom" default_order="sequence asc, name asc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="behavior"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

