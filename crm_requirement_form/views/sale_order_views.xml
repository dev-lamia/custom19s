<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_requirement_specification_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.requirement.specification.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_requirement_form"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not requirement_form_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Requirement Form</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="requirement_form_id"
                       string="Requirement Form (Optional)"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="has_existing_gdn" invisible="1"/>
            </xpath>

            <!-- Reused GDN = stored specification snapshot. Lock the row data. -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="readonly" add="gdn_from_existing" separator=" or "/>
                <attribute name="string">Product</attribute>
                <attribute name="domain">[('sale_ok', '=', True), ('product_tmpl_id.requirement_fg_type', '=', req_fg_type)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="attributes">
                <attribute name="readonly" add="gdn_from_existing" separator=" or "/>
                <attribute name="string">Product</attribute>
                <attribute name="domain">[('sale_ok', '=', True), ('requirement_fg_type', '=', req_fg_type)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="attributes">
                <attribute name="readonly">gdn_from_existing</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly" add="gdn_from_existing" separator=" or "/>
                <attribute name="string">QTY</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly" add="gdn_from_existing" separator=" or "/>
            </xpath>
            <!-- Unit Price must remain editable, including reused GDN lines. -->
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">False</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='tax_ids']" position="attributes">
                <attribute name="readonly" add="gdn_from_existing" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="attributes">
                <attribute name="readonly">gdn_from_existing</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='customer_lead']" position="attributes">
                <attribute name="readonly" add="gdn_from_existing" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='analytic_distribution']" position="attributes">
                <attribute name="readonly">gdn_from_existing</attribute>
            </xpath>

            <!-- Direct Sales flow: Customer -> GDN -> auto-filled FG Type/Product. -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="before">
                <field name="gdn_configuration_id"
                       widget="gdn_link_many2one"
                       string="Select GDN"
                       optional="show"
                       width="220px"
                       readonly="gdn_configuration_id"
                       force_save="1"
                       domain="['|', ('partner_id', '=', gdn_customer_id), ('id', '=', gdn_configuration_id)]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="req_fg_type"
                       readonly="gdn_from_existing"
                       string="FG Type"
                       optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="after">
                <field name="gdn_number_link"
                       string="GDN Number"
                       widget="html"
                       readonly="1"
                       optional="show"/>
                <field name="job_code_link"
                       string="Job Code"
                       widget="html"
                       readonly="1"
                       optional="show"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list" position="inside">
                <!-- Keep only the requested Requirement Specification columns. -->
                <field name="job_configuration_id" column_invisible="True"/>

                <!-- Technical fields required by the GDN domain/locking logic. -->
                <field name="gdn_customer_id" column_invisible="True"/>
                <field name="gdn_order_partner_id" column_invisible="True"/>
                <field name="gdn_order_state" column_invisible="True"/>
                <field name="gdn_from_existing" column_invisible="True"/>
                <field name="gdn_number" column_invisible="True" force_save="1"/>

                <button name="action_generate_gdn"
                        type="object"
                        string="Generate GDN"
                        class="btn-primary"
                        invisible="display_type or gdn_configuration_id or gdn_number or gdn_order_state not in ['draft', 'sent', 'sale']"/>

                <!-- Keep the requirement quantity technically available for
                     snapshot/GDN/job-code logic, but do not show a duplicate
                     quantity column beside the standard sale quantity. -->
                <field name="req_quantity"
                       column_invisible="True"
                       force_save="1"/>

                <!--
                    Keep legacy specification fields in the sale order line
                    architecture so existing Odoo Studio inherited views that
                    target them can still resolve their xpath expressions.
                    They are technical-only now; the visible Product column is
                    the standard sale product field.
                -->
                <field name="req_bag_type_product_tmpl_id"
                       column_invisible="True"
                       force_save="1"/>
                <field name="req_roll_type"
                       column_invisible="True"
                       force_save="1"/>
            </xpath>
        </field>
    </record>
    <record id="sale_order_list_job_gdn_summary_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.job.gdn.summary.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="client_order_ref" position="after">
                <field name="job_code_summary" string="Job Code" optional="show"/>
                <field name="gdn_number_summary" string="GDN Number" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
