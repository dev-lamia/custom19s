<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_customer_rating_list" model="ir.ui.view">
        <field name="name">crm.customer.rating.list</field>
        <field name="model">crm.customer.rating</field>
        <field name="arch" type="xml">
            <list string="Customer Rankings" default_order="write_date desc">
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="rank" widget="badge"
                       decoration-success="rank == 'a'"
                       decoration-warning="rank == 'b'"
                       decoration-danger="rank == 'c'"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="crm_customer_rating_form" model="ir.ui.view">
        <field name="name">crm.customer.rating.form</field>
        <field name="model">crm.customer.rating</field>
        <field name="arch" type="xml">
            <form string="Customer Ranking">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="lead_id" options="{'no_create': True}"/>
                            <field name="partner_id" readonly="lead_id" required="not lead_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Final Result">
                            <field name="manual_rank" widget="radio"/>
                            <field name="rank" readonly="1" widget="badge"
                                   decoration-success="rank == 'a'"
                                   decoration-warning="rank == 'b'"
                                   decoration-danger="rank == 'c'"/>
                        </group>
                    </group>

                    <group string="Customer Ranking">
                        <group>
                            <field name="responsiveness_score" widget="radio"/>
                            <field name="behavior_score" widget="radio"/>
                            <field name="payment_on_time_score" widget="radio"/>
                        </group>
                        <group>
                            <field name="meeting_adherence_score" widget="radio"/>
                            <field name="requirements_artwork_score" widget="radio"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        Select A, B, or C for each question. No point entry is required.
                    </div>

                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Any reason or comment for this ranking..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_crm_customer_rating" model="ir.actions.act_window">
        <field name="name">Customer Rankings</field>
        <field name="res_model">crm.customer.rating</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
