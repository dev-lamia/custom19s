<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_item_code" model="ir.ui.view">
        <field name="name">purchase.order.form.item.code</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="requirement_item_code"
                       string="Item Code"
                       readonly="1"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
