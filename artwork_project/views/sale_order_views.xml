<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_artwork_project_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.artwork.project.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_create_artwork" invisible="1"/>
                <button name="action_create_artwork"
                        type="object"
                        string="Create Artwork"
                        class="btn-primary"
                        invisible="not can_create_artwork or artwork_task_count != 0"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_artwork"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-paint-brush"
                        invisible="artwork_task_count == 0">
                    <field name="artwork_task_count" widget="statinfo" string="Artwork"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
