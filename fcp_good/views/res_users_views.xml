<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_fcp_chatter_position" model="ir.ui.view">
        <field name="name">res.users.form.fcp.chatter.position</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notification_type']" position="after">
                <field name="fcp_chatter_position" widget="radio" />
            </xpath>
        </field>
    </record>
</odoo>