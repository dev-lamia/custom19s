<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Employee Portal — List Page
         ============================================================ -->
    <template id="portal_my_payslips" name="Employee Portal">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
                <div>
                    <h4 class="fw-bold mb-1">
                        <i class="fa fa-file-text-o me-2 text-info"/>
                        My Payslips
                    </h4>
                    <p class="text-muted mb-0">View and download your salary slips</p>
                </div>
                <a href="/my/employee-portal" class="btn ess-back-btn">
                    <i class="fa fa-arrow-left me-1"/> Back to Employee Portal
                </a>
            </div>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Employee Portal</t>
            </t>

            <t t-if="not payslips">
                <div class="alert alert-info text-center mt-3" role="alert">
                    <i class="fa fa-info-circle me-2"/>
                    No validated payslips found yet. Please check back after the next payroll run.
                </div>
            </t>

            <t t-if="payslips">
                <div class="card mt-3 employee-payslip-card">
                    <div class="card-header bg-primary text-white d-flex align-items-center">
                        <i class="fa fa-file-text-o me-2 fs-5"/>
                        <h5 class="mb-0">Salary Slips</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Reference</th>
                                    <th>Period</th>
                                    <th>Net Salary</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="payslips" t-as="payslip">
                                    <tr>
                                        <td>
                                            <a t-attf-href="/my/payslips/#{payslip.id}" class="fw-semibold text-primary">
                                                <t t-esc="payslip.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <span t-field="payslip.date_from" t-options='{"widget": "date"}'/> —
                                            <span t-field="payslip.date_to" t-options='{"widget": "date"}'/>
                                        </td>
                                        <td class="fw-bold">
                                            <span t-field="payslip.net_wage"
                                                  t-options='{"widget": "monetary", "display_currency": payslip.currency_id}'/>
                                        </td>
                                        <td>
                                            <span t-if="payslip.state == 'paid'"
                                                  class="badge bg-success">Paid</span>
                                            <span t-elif="payslip.state == 'validated'"
                                                  class="badge bg-primary">Validated</span>
                                            <span t-else=""
                                                  class="badge bg-secondary">
                                                <t t-esc="payslip.state"/>
                                            </span>
                                        </td>
                                        <td>
                                            <a t-attf-href="/my/payslips/#{payslip.id}/preview"
                                               class="btn btn-sm btn-outline-primary me-1" target="_blank">
                                                <i class="fa fa-eye"/> Preview
                                            </a>
                                            <a t-attf-href="/my/payslips/#{payslip.id}/download"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="fa fa-download"/> PDF
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pager -->
                <div class="o_portal_pager text-center mt-3">
                    <t t-if="pager['page_count'] > 1">
                        <t t-call="portal.pager"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================
         Payslip Detail Page
         ============================================================ -->
    <template id="portal_payslip_detail" name="Payslip Detail">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="base.group_user"/>

            <!-- Breadcrumb -->
            <t t-call="portal.portal_record_layout">
                <t t-set="card_header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h5 class="mb-0">
                                <i class="fa fa-file-text-o text-primary me-2"/>
                                <span t-field="payslip.name"/>
                            </h5>
                            <small class="text-muted">
                                <span t-field="payslip.date_from" t-options='{"widget":"date"}'/> to
                                <span t-field="payslip.date_to" t-options='{"widget":"date"}'/>
                            </small>
                        </div>
                        <div class="d-flex gap-2">
                            <span t-if="payslip.state == 'paid'" class="badge bg-success fs-6">Paid</span>
                            <span t-elif="payslip.state == 'validated'" class="badge bg-primary fs-6">Validated</span>
                            <a t-attf-href="/my/payslips/#{payslip.id}/download"
                               class="btn btn-success btn-sm">
                                <i class="fa fa-download me-1"/> Download PDF
                            </a>
                        </div>
                    </div>
                </t>

                <t t-set="card_body">
                    <!-- Employee Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted fw-semibold mb-3">Employee Information</h6>
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="text-muted w-40">Name</td>
                                    <td class="fw-semibold"><t t-esc="employee.name"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Job Position</td>
                                    <td><t t-esc="employee.job_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Department</td>
                                    <td><t t-esc="employee.department_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Company</td>
                                    <td><t t-esc="payslip.company_id.name"/></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted fw-semibold mb-3">Payslip Information</h6>
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="text-muted w-40">Reference</td>
                                    <td class="fw-semibold"><t t-esc="payslip.name"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Pay Period</td>
                                    <td>
                                        <span t-field="payslip.date_from" t-options='{"widget":"date"}'/> —
                                        <span t-field="payslip.date_to" t-options='{"widget":"date"}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Salary Structure</td>
                                    <td><t t-esc="payslip.struct_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Status</td>
                                    <td>
                                        <span t-if="payslip.state == 'paid'" class="badge bg-success">Paid</span>
                                        <span t-elif="payslip.state == 'validated'" class="badge bg-primary">Validated</span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Salary Lines -->
                    <h6 class="text-uppercase text-muted fw-semibold mb-3">Salary Details</h6>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered payslip-lines-table">
                            <thead class="table-dark">
                                <tr>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Rate</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines" t-as="line">
                                    <tr t-att-class="'table-success fw-bold' if line.code == 'NET' else ''">
                                        <td><t t-esc="line.name"/></td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                <t t-esc="line.category_id.name"/>
                                            </span>
                                        </td>
                                        <td class="text-end"><t t-esc="line.quantity"/></td>
                                        <td class="text-end"><t t-esc="line.rate"/> %</td>
                                        <td class="text-end fw-semibold">
                                            <span t-field="line.total"
                                                  t-options='{"widget": "monetary", "display_currency": payslip.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot class="table-dark">
                                <tr>
                                    <td colspan="4" class="text-end fw-bold fs-5">Net Salary</td>
                                    <td class="text-end fw-bold fs-5 text-success">
                                        <span t-field="payslip.net_wage"
                                              t-options='{"widget": "monetary", "display_currency": payslip.currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Back Button -->
                    <div class="mt-4">
                        <a href="/my/payslips" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"/> Back to Employee Portal
                        </a>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
