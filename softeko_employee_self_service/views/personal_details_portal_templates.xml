<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_personal_details" name="Portal My Personal Details">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">
                            <i class="fa fa-user-circle-o me-2 text-info"/>
                            My Personal Details
                        </h4>
                        <p class="text-muted mb-0">View your employee personal information</p>
                    </div>
                    <a href="/my/employee-portal" class="btn btn-outline-warning ess-back-btn">
                        <i class="fa fa-arrow-left me-1"/> Back to Employee Portal
                    </a>
                </div>

                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold mb-0">Private Contact</h5>
                            </div>
                            <div class="card-body pt-3">
                                <t t-if="private_contact_items">
                                    <table class="table table-borderless align-middle mb-0">
                                        <tbody>
                                            <t t-foreach="private_contact_items" t-as="item">
                                                <tr>
                                                    <th class="text-muted fw-semibold ps-0" style="width: 45%;">
                                                        <t t-esc="item['label']"/>
                                                    </th>
                                                    <td class="pe-0 text-end">
                                                        <t t-esc="item['value']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="text-muted">No private contact information found.</div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold mb-0">Personal Information</h5>
                            </div>
                            <div class="card-body pt-3">
                                <t t-if="personal_info_items">
                                    <table class="table table-borderless align-middle mb-0">
                                        <tbody>
                                            <t t-foreach="personal_info_items" t-as="item">
                                                <tr>
                                                    <th class="text-muted fw-semibold ps-0" style="width: 45%;">
                                                        <t t-esc="item['label']"/>
                                                    </th>
                                                    <td class="pe-0 text-end">
                                                        <t t-esc="item['value']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="text-muted">No personal information found.</div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold mb-0">Emergency Contact</h5>
                            </div>
                            <div class="card-body pt-3">
                                <t t-if="emergency_items">
                                    <table class="table table-borderless align-middle mb-0">
                                        <tbody>
                                            <t t-foreach="emergency_items" t-as="item">
                                                <tr>
                                                    <th class="text-muted fw-semibold ps-0" style="width: 45%;">
                                                        <t t-esc="item['label']"/>
                                                    </th>
                                                    <td class="pe-0 text-end">
                                                        <t t-esc="item['value']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="text-muted">No emergency contact information found.</div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold mb-0">Citizenship</h5>
                            </div>
                            <div class="card-body pt-3">
                                <t t-if="citizenship_items">
                                    <table class="table table-borderless align-middle mb-0">
                                        <tbody>
                                            <t t-foreach="citizenship_items" t-as="item">
                                                <tr>
                                                    <th class="text-muted fw-semibold ps-0" style="width: 45%;">
                                                        <t t-esc="item['label']"/>
                                                    </th>
                                                    <td class="pe-0 text-end">
                                                        <t t-esc="item['value']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="text-muted">No citizenship information found.</div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold mb-0">Visa &amp; Work Permit</h5>
                            </div>
                            <div class="card-body pt-3">
                                <t t-if="visa_items">
                                    <table class="table table-borderless align-middle mb-0">
                                        <tbody>
                                            <t t-foreach="visa_items" t-as="item">
                                                <tr>
                                                    <th class="text-muted fw-semibold ps-0" style="width: 45%;">
                                                        <t t-esc="item['label']"/>
                                                    </th>
                                                    <td class="pe-0 text-end">
                                                        <t t-esc="item['value']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="text-muted">No visa or work permit information found.</div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold mb-0">Location</h5>
                            </div>
                            <div class="card-body pt-3">
                                <t t-if="location_items">
                                    <table class="table table-borderless align-middle mb-0">
                                        <tbody>
                                            <t t-foreach="location_items" t-as="item">
                                                <tr>
                                                    <th class="text-muted fw-semibold ps-0" style="width: 45%;">
                                                        <t t-esc="item['label']"/>
                                                    </th>
                                                    <td class="pe-0 text-end">
                                                        <t t-esc="item['value']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="text-muted">No location information found.</div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
