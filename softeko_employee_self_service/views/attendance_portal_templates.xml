<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_attendances" name="My Attendances">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="container py-4">
                <!-- Header with Back button -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">
                            <i class="fa fa-clock-o me-2 text-info"/>
                            My Attendance
                        </h4>
                        <p class="text-muted mb-0">View your check-in and check-out records</p>
                    </div>
                    <a href="/my/employee-portal" class="btn ess-back-btn">
                        <i class="fa fa-arrow-left me-1"/> Back to Employee Portal
                    </a>
                </div>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Attendance</t>
                </t>

                <!-- Summary Cards -->
                <div class="row g-3 mt-1 mb-3">
                    <div class="col-sm-6 col-md-4">
                        <div class="card border-0 shadow-sm h-100 text-center py-3">
                            <div class="card-body">
                                <i class="fa fa-calendar-check-o fa-2x text-primary mb-2"/>
                                <h4 class="fw-bold mb-0"><t t-esc="total_days"/></h4>
                                <small class="text-muted">Total Days</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <div class="card border-0 shadow-sm h-100 text-center py-3">
                            <div class="card-body">
                                <i class="fa fa-clock-o fa-2x text-success mb-2"/>
                                <h4 class="fw-bold mb-0"><t t-esc="'%.1f' % total_hours"/> h</h4>
                                <small class="text-muted">Total Hours</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4">
                        <div class="card border-0 shadow-sm h-100 text-center py-3">
                            <div class="card-body">
                                <i class="fa fa-bar-chart fa-2x text-info mb-2"/>
                                <h4 class="fw-bold mb-0">
                                    <t t-esc="'%.1f' % (total_hours / total_days if total_days else 0)"/> h
                                </h4>
                                <small class="text-muted">Avg Hours / Day</small>
                            </div>
                        </div>
                    </div>
                </div>

                <t t-if="not attendances">
                    <div class="alert alert-info text-center mt-3" role="alert">
                        <i class="fa fa-info-circle me-2"/>
                        No attendance records found for the selected period.
                    </div>
                </t>

                <t t-if="attendances">
                    <div class="card mt-2 ess-attendance-card">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle ess-attendance-table">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Employee</th>
                                        <th>Check In</th>
                                        <th>Check Out</th>
                                        <th class="text-end">Worked Hours</th>
                                        <th class="text-end">Worked Extra Hours</th>
                                        <th class="text-end pe-3">Extra Hours</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="attendances" t-as="att">
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <img t-att-src="'/web/image/hr.employee/%d/avatar_128' % att.employee_id.id"
                                                         class="rounded-circle ess-emp-avatar"
                                                         alt=""
                                                         onerror="this.style.display='none'"/>
                                                    <span class="fw-semibold"><t t-esc="att.employee_id.name"/></span>
                                                </div>
                                            </td>
                                            <td>
                                                <t t-if="att.check_in">
                                                    <span t-field="att.check_in" t-options='{"widget": "datetime", "format": "MMM d, h:mm a"}'/>
                                                </t>
                                                <t t-else=""><span class="text-muted">&#8212;</span></t>
                                            </td>
                                            <td>
                                                <t t-if="att.check_out">
                                                    <span t-field="att.check_out" t-options='{"widget": "datetime", "format": "MMM d, h:mm a"}'/>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="fa fa-hourglass-half me-1"/> In Progress
                                                    </span>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="att.worked_hours">
                                                    <t t-esc="'%02d:%02d' % (int(att.worked_hours), int((att.worked_hours % 1) * 60))"/>
                                                </t>
                                                <t t-else=""><span class="text-muted">00:00</span></t>
                                            </td>
                                            <td class="text-end">
                                                <span class="text-muted">00:00</span>
                                            </td>
                                            <td class="text-end pe-3">
                                                <span class="text-muted">00:00</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="o_portal_pager text-center mt-3">
                        <t t-if="pager['page_count'] > 1">
                            <t t-call="portal.pager"/>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
