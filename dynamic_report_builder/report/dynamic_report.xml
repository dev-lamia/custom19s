<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_dynamic" model="ir.actions.report">
        <field name="name">Dynamic Report</field>
        <field name="model">dynamic.report.config</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dynamic_report_builder.report_dynamic_document</field>
        <field name="report_file">dynamic_report_builder.report_dynamic_document</field>
        <field name="print_report_name">'Dynamic Report - %s' % (object.model_id.name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>
    <!-- Print the runtime filter wizard itself: its id is a native report
         docid, so selected dates cannot disappear from report options. -->
    <record id="action_report_dynamic_filtered" model="ir.actions.report">
        <field name="name">Dynamic Report</field>
        <field name="model">dynamic.report.date.filter.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dynamic_report_builder.report_dynamic_filtered_document</field>
        <field name="report_file">dynamic_report_builder.report_dynamic_filtered_document</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
