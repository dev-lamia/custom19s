<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_professional_approval_request" model="ir.sequence">
        <field name="name">Dynamic Approval Request</field>
        <field name="code">professional.approval.request</field>
        <field name="prefix">APR/</field>
        <field name="padding">5</field>
    </record>

    <record id="group_professional_approval_user" model="res.groups">
        <field name="name">Dynamic Approval User</field>
    </record>

    <record id="group_professional_approval_manager" model="res.groups">
        <field name="name">Dynamic Approval Manager</field>
        <field name="implied_ids" eval="[(4, ref('dynamic_approval.group_professional_approval_user'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('dynamic_approval.group_professional_approval_user'))]"/>
    </record>

    <record id="rule_professional_approval_request_user" model="ir.rule">
        <field name="name">Approval request own and assigned</field>
        <field name="model_id" ref="model_professional_approval_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', '|', ('request_owner_id', '=', user.id), ('line_ids.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_professional_approval_request_manager" model="ir.rule">
        <field name="name">Approval request manager all</field>
        <field name="model_id" ref="model_professional_approval_request"/>
        <field name="groups" eval="[(4, ref('dynamic_approval.group_professional_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
