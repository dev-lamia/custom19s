<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_professional_approval_popup_form" model="ir.ui.view">
        <field name="name">professional.approval.popup.form</field>
        <field name="model">professional.approval.popup</field>
        <field name="arch" type="xml">
            <form string="Approval Message">
                <sheet>
                    <group>
                        <field name="message" nolabel="1" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button string="OK" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
