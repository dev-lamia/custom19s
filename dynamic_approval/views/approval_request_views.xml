<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_professional_approval_request_list" model="ir.ui.view">
        <field name="name">professional.approval.request.list</field>
        <field name="model">professional.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="source_name"/>
                <field name="button_label"/>
                <field name="request_owner_id"/>
                <field name="next_approver_names"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'pending'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_professional_approval_request_form" model="ir.ui.view">
        <field name="name">professional.approval.request.form</field>
        <field name="model">professional.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'" groups="dynamic_approval.group_professional_approval_user"/>
                    <button name="action_open_source" type="object" string="Open Source" class="btn-secondary"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'pending'" groups="dynamic_approval.group_professional_approval_user"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'pending'" groups="dynamic_approval.group_professional_approval_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="source_name" readonly="1"/>
                            <field name="source_model" readonly="1"/>
                            <field name="source_id" readonly="1"/>
                            <field name="button_label" readonly="1"/>
                            <field name="method_name" readonly="1"/>
                        </group>
                        <group string="Approval">
                            <field name="rule_id" readonly="1"/>
                            <field name="request_owner_id" readonly="1"/>
                            <field name="approved_count" readonly="1"/>
                            <field name="required_count" readonly="1"/>
                            <field name="next_approver_names" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approver Progress">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="required"/>
                                    <field name="status" widget="badge" decoration-success="status == 'approved'" decoration-warning="status == 'waiting'" decoration-danger="status == 'rejected'"/>
                                    <field name="approved_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_professional_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">professional.approval.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
