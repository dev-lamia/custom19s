<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_professional_approval_rule_list" model="ir.ui.view">
        <field name="name">professional.approval.rule.list</field>
        <field name="model">professional.approval.rule</field>
        <field name="arch" type="xml">
            <list string="Approval Rules" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="button_id"/>
                <field name="company_ids" widget="many2many_tags" optional="show"/>
                <field name="sequential_approval" optional="hide"/>
                <field name="minimum_approvals" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_professional_approval_rule_form" model="ir.ui.view">
        <field name="name">professional.approval.rule.form</field>
        <field name="model">professional.approval.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Rule">
                <header>
                    <button name="action_refresh_buttons"
                            type="object"
                            string="Refresh Available Buttons"
                            class="btn-secondary"
                            icon="fa-refresh"
                            invisible="not model_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check-square-o">
                            <field name="request_count" widget="statinfo" string="Requests"/>
                        </button>
                    </div>

                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>

                    <div class="oe_title">
                        <label for="name" string="Approval Rule"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sales Confirmation Approval"/>
                        </h1>
                    </div>

                    <div class="alert alert-info" role="alert">
                        Select the business action, define who can request it, and add the users who must approve it.
                        Leave <strong>Applicable Companies</strong> empty to use this rule in every company.
                    </div>

                    <group>
                        <group string="Rule Setup">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="sequence"/>
                            <field name="company_ids"
                                   widget="many2many_tags"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True, 'no_edit': True}"
                                   placeholder="All companies"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Action to Protect">
                            <field name="model_id"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="button_id"
                                   domain="[('model_id', '=', model_id)]"
                                   context="{'approval_model_id': model_id}"
                                   options="{'no_create': True, 'no_edit': True}"
                                   invisible="not model_id"/>
                            <field name="model_name" readonly="1" invisible="not model_id"/>
                            <field name="method_name" readonly="1" invisible="not button_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Approval Flow" name="approval_flow">
                            <group>
                                <group string="Approval Policy">
                                    <field name="sequential_approval"/>
                                    <field name="minimum_approvals"/>
                                </group>
                                <group string="Who Can Request">
                                    <field name="initiator_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True, 'no_edit': True}"
                                           placeholder="All internal users"/>
                                    <div class="text-muted">
                                        Leave empty to allow every internal user to request approval.
                                    </div>
                                </group>
                            </group>

                            <separator string="Approvers"/>
                            <field name="approver_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"
                                           options="{'no_create': True, 'no_edit': True}"/>
                                    <field name="required" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>

                        <page string="Conditions" name="conditions">
                            <div class="alert alert-secondary" role="alert">
                                Add an optional domain when this approval should only apply to selected records,
                                such as orders above a specific amount. Leave it empty for every record.
                            </div>
                            <group>
                                <field name="condition_domain"
                                       widget="domain"
                                       options="{'model': 'model_name'}"
                                       placeholder="[]"
                                       nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_professional_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">professional.approval.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
