<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_dept_tag" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.user.customer.industry.filter</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="user_customer_domain" invisible="1"/>
                <field name="department_partner_domain" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">user_customer_domain</attribute>
                <attribute name="context">{'filter_sale_customer_by_user_industries': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
