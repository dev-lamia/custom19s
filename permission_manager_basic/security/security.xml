<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 19 community build can raise Invalid field 'category_id'
        on res.groups, so groups are created without category_id.
    -->
    <record id="group_permission_manager_user" model="res.groups">
        <field name="name">Access Management User</field>
    </record>

    <record id="group_permission_manager_admin" model="res.groups">
        <field name="name">Access Management Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_permission_manager_user'))]"/>
    </record>

    <!-- Settings administrators can see the app and manage policies immediately. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_permission_manager_admin'))]"/>
    </record>
</odoo>
