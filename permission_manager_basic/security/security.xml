<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One explicit user checkbox controls app visibility and all module ACLs. -->
    <record id="group_permission_manager_user" model="res.groups">
        <field name="name">Access Management</field>
    </record>

    <!--
        Upgrade compatibility: the previous Administrator group is recreated
        only so that its old external ID can be safely retired on both fresh
        installs and upgrades. It is deleted before loading menus/views.
    -->
    <record id="group_permission_manager_admin" model="res.groups">
        <field name="name">Access Management Administrator</field>
    </record>

    <!-- Neither Settings Administrator nor any other role grants app access. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('group_permission_manager_admin')), (3, ref('group_permission_manager_user'))]"/>
    </record>

    <!-- Retire old Administrator-specific grants before deleting the group. -->
    <delete model="ir.model.access"
            search="[('group_id', '=', ref('group_permission_manager_admin'))]"/>
    <delete id="group_permission_manager_admin" model="res.groups"/>
</odoo>
