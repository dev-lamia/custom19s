<odoo>
  <record id="view_purchase_requisition_delivery_form" model="ir.ui.view">
    <field name="name">softeko.purchase.requisition.delivery.form</field>
    <field name="model">softeko.purchase.requisition.delivery</field>
    <field name="arch" type="xml">
        <form string="Delivery Schedule">
            <sheet>
                <group col="2">
                    <group>
                        <field name="categ_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="total_quantity" readonly="1"/>
                    </group>
                    <group>
                        <field name="delivery_location"/>
                        <field name="remark"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </group>

                <separator string="Delivery Lines"/>
                <field name="schedule_line_ids">
                    <list editable="bottom">
                        <field name="schedule_date"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="remarks"/>
                    </list>
                </field>
            </sheet>
        </form>
    </field>
</record>
</odoo>