<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_requisition" model="ir.ui.view">
        <field name="name">purchase.order.form.requisition.link</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pr_requisitions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="pr_requisition_count == 0">

                    <field name="pr_requisition_count"
                        widget="statinfo"
                        string="PR"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="pr_requisition_id" invisible="1"/>
                <field name="pr_requisition_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       domain="[('state','=','rfq')]"
                       readonly="state not in ('draft', 'sent', 'to approve')"
                       groups="purchase.group_purchase_user,purchase.group_purchase_manager,account.group_account_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_inherit_pr" model="ir.ui.view">
        <field name="name">purchase.order.filter.pr.pr</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="pr_requisition_ids" string="Purchase Requisition"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_search_inherit_pr" model="ir.ui.view">
        <field name="name">purchase.order.search.pr.pr</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="pr_requisition_ids" string="Purchase Requisition"/>
            </xpath>
        </field>
    </record>
</odoo>
