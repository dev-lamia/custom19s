<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_softeko_purchase_requisition_change_request_wizard_form" model="ir.ui.view">
        <field name="name">softeko.purchase.requisition.change.request.wizard.form</field>
        <field name="model">softeko.purchase.requisition.change.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Requisition Request">
                <group>
                    <field name="requisition_id"/>
                    <field name="action_type"/>
                    <field name="reason" placeholder="Explain why this requisition must be reset or cancelled..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
