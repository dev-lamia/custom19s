<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_softeko_purchase_requisition_own" model="ir.rule">
        <field name="name">Purchase Requisition - Own Requisition</field>
        <field name="model_id" ref="model_softeko_purchase_requisition"/>
        <field name="groups" eval="[(4, ref('softeko_purchase_requisition.group_pr_own'))]"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
    </record>

    <record id="rule_softeko_purchase_requisition_team" model="ir.rule">
        <field name="name">Purchase Requisition - Team Approver</field>
        <field name="model_id" ref="model_softeko_purchase_requisition"/>
        <field name="groups" eval="[(4, ref('softeko_purchase_requisition.group_pr_team'))]"/>
        <field name="domain_force">
            ['|', '|', '|',
                ('requester_id', '=', user.id),
                ('manager_user_id', '=', user.id),
                ('activity_ids.user_id', '=', user.id),
                ('stakeholder_user_ids', 'in', user.id)
            ]
        </field>
    </record>

    <record id="rule_softeko_purchase_requisition_admin" model="ir.rule">
        <field name="name">Purchase Requisition - Administrator</field>
        <field name="model_id" ref="model_softeko_purchase_requisition"/>
        <field name="groups" eval="[(4, ref('softeko_purchase_requisition.group_pr_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>


    <record id="rule_softeko_purchase_requisition_approval_company" model="ir.rule">
        <field name="name">PR Approval Configuration - Selected Companies</field>
        <field name="model_id" ref="model_softeko_purchase_requisition_approval"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>