<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Privilege -->
        <record id="res_groups_privilege_purchase_requisition" model="res.groups.privilege">
            <field name="name">Purchase Requisition</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
            <field name="placeholder"></field>
        </record>

        <!-- Groups -->
        <record id="group_pr_own" model="res.groups">
            <field name="name">Own Requisition</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="softeko_purchase_requisition.res_groups_privilege_purchase_requisition"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_pr_team" model="res.groups">
            <field name="name">Team Approver</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="softeko_purchase_requisition.res_groups_privilege_purchase_requisition"/>
            <field name="implied_ids" eval="[(4, ref('softeko_purchase_requisition.group_pr_own'))]"/>
        </record>

        <record id="group_pr_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="softeko_purchase_requisition.res_groups_privilege_purchase_requisition"/>
            <field name="implied_ids" eval="[(4, ref('softeko_purchase_requisition.group_pr_team'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>