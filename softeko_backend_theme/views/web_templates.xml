<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="softeko_webclient_branding" inherit_id="web.webclient_bootstrap" name="Softeko backend tab icon and company CSS">
        <xpath expr="//t[@t-call='web.layout']" position="inside">
            <t t-set="x_icon" t-value="'/softeko_theme/favicon'"/>
        </xpath>
        <xpath expr="//t[@t-set='head_web']" position="inside">
            <link rel="stylesheet" href="/softeko_theme/styles.css" type="text/css"/>
        </xpath>
    </template>
    <template id="softeko_login_credit" inherit_id="web.login_layout" name="Softeko login credit">
        <xpath expr="//div[contains(@class, 'card-body')]" position="inside">
            <div class="softeko_login_credit">Configured with <b>Softeko</b> | <span>Lamia Akter</span></div>
        </xpath>
    </template>
</odoo>
