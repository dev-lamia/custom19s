<odoo>
<record id="view_type_list" model="ir.ui.view"><field name="name">tam.document.type.list</field><field name="model">tam.document.type</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="folder_count"/><field name="active"/></list></field></record>
<record id="view_type_form" model="ir.ui.view"><field name="name">tam.document.type.form</field><field name="model">tam.document.type</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_view_folders" type="object" class="oe_stat_button" icon="fa-folder"><field name="folder_count" widget="statinfo" string="Folders"/></button></div><group><field name="name"/><field name="sequence"/><field name="active"/><field name="description"/></group><notebook><page string="Folders"><field name="folder_ids" context="{'default_type_id': id}"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="parent_id" domain="[('type_id', '=', parent.id)]"/></list></field></page></notebook></sheet></form></field></record>
<record id="view_folder_list" model="ir.ui.view"><field name="name">tam.document.folder.list</field><field name="model">tam.document.folder</field><field name="arch" type="xml"><list><field name="complete_name"/><field name="type_id"/><field name="parent_id"/><field name="file_count"/></list></field></record>
<record id="view_folder_form" model="ir.ui.view"><field name="name">tam.document.folder.form</field><field name="model">tam.document.folder</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_view_files" type="object" class="oe_stat_button" icon="fa-files-o"><field name="file_count" widget="statinfo" string="Documents"/></button></div><group><field name="name"/><field name="type_id"/><field name="parent_id" domain="[('type_id', '=', type_id), ('id', '!=', id)]"/><field name="complete_name" readonly="1"/></group><notebook><page string="Subfolders"><field name="child_ids" context="{'default_type_id': type_id}"><list editable="bottom"><field name="name"/><field name="type_id" column_invisible="True"/></list></field></page><page string="Documents"><field name="file_ids" context="{'default_type_id': type_id}"><list><field name="name"/><field name="expiry_date"/></list></field></page></notebook></sheet></form></field></record>
<record id="view_file_list" model="ir.ui.view"><field name="name">tam.document.file.list</field><field name="model">tam.document.file</field><field name="arch" type="xml"><list><field name="name"/><field name="type_id"/><field name="folder_id"/><field name="expiry_date"/></list></field></record>
<record id="view_file_form" model="ir.ui.view"><field name="name">tam.document.file.form</field><field name="model">tam.document.file</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="type_id"/><field name="folder_id" domain="[('type_id', '=', type_id)]"/><field name="expiry_date"/></group><group><field name="attachment_ids" widget="many2many_binary"/><field name="notes"/></group></sheet><chatter/></form></field></record>
<record id="action_types" model="ir.actions.act_window"><field name="name">Document Types</field><field name="res_model">tam.document.type</field><field name="view_mode">list,form</field></record>
<record id="action_folders" model="ir.actions.act_window"><field name="name">Folders</field><field name="res_model">tam.document.folder</field><field name="view_mode">list,form</field></record>
<record id="action_files" model="ir.actions.act_window"><field name="name">Documents</field><field name="res_model">tam.document.file</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_root" name="Document Manager" sequence="55" groups="tam_document_manager.group_document_user"/>
<menuitem id="menu_files" name="Documents" parent="menu_root" action="action_files" sequence="10"/>
<menuitem id="menu_folders" name="Folders" parent="menu_root" action="action_folders" sequence="20"/>
<menuitem id="menu_types" name="Document Types" parent="menu_root" action="action_types" sequence="30" groups="tam_document_manager.group_document_manager"/>
</odoo>